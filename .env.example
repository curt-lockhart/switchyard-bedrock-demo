# ./scripts/setup.sh copies this file to .env.local. No Bedrock key is needed here:
# the deploy scripts generate a short-term token and put it on the Lambda.

# AWS profile the app uses to invoke the Switchyard Lambda. Use an SSO profile
# you log in to with "aws sso login --profile <name>". If unset, the default AWS
# credential chain is used, where stale keys in ~/.aws/credentials take priority.
# AWS_PROFILE=

# Switchyard Lambda (defaults shown)
SWITCHYARD_LAMBDA_FN=switchyard-demo-proxy
SWITCHYARD_LAMBDA_REGION=us-east-1

# Default route: support-triage-classifier | support-triage-3tier | baseline
SWITCHYARD_ROUTE=support-triage-classifier
